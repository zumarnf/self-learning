# Ruang Belajar Fullstack — environment variables
#
# This application has NO backend, NO database, and NO authentication, so it needs no secrets.
# The file exists so that any future variable is added here with an empty placeholder first.
#
# Rules that apply here (.claude/rules/security.md):
#   - Never put a real secret in this file. Placeholders only.
#   - Anything prefixed NEXT_PUBLIC_ is shipped to the browser and is therefore PUBLIC.
#     Never place a credential behind that prefix.
#   - .env and .env.local are git-ignored; only this example file is committed.

# Public base URL, used for metadata and Open Graph tags. Safe to expose.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
